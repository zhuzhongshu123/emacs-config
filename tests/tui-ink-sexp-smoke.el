;;; tui-ink-sexp-smoke.el --- Structured Ink integration -*- lexical-binding: t; -*-
(require 'cl-lib)
(require 'ert)
(require 'python)
(cl-letf (((symbol-function 'ert-run-tests-batch-and-exit) #'ignore))
  (load (expand-file-name "tui-reading-ports-smoke.el" (file-name-directory load-file-name)) nil t))

(defun ink-test-document (text)
  (list :version 1 :offset-unit 'unicode-scalar :width 60 :text text
        :styles [(:fg "ansi:red")] :runs (vector (list 0 (length text) 0))
        :headings [] :code-blocks [] :footnotes []))

(ert-deftest ink-sexp-rejects-invalid-data-without-evaluation ()
  (dolist (text '("#. (error \"evaluated\")" "#1=(:text #1#)"))
    (with-temp-buffer
      (insert text)
      (should-error (my-tui-ink-read-document (current-buffer)))))
  (dolist (change '((:version 2) (:offset-unit utf8-byte)
                    (:runs [(0 99 0)]) (:runs [(0 1 5)])
                    (:styles [(:bold eval)]) (:headings [(0 1 "x" "x" 0)])
                    (:code-blocks [(0 1 "python" "z" [(0 1 0)])])))
    (with-temp-buffer
      (let ((data (ink-test-document "中")))
        (setq data (plist-put data (car change) (cadr change)))
        (prin1 data (current-buffer))
        (should-error (my-tui-ink-read-document (current-buffer))))))
  (with-temp-buffer
    (prin1 (ink-test-document "中🙂") (current-buffer))
    (insert " (extra)")
    (should-error (my-tui-ink-read-document (current-buffer)))))

(ert-deftest ink-sexp-characters-wrap-fontify-and-toc ()
  (should (executable-find my-tui-ink-native-program))
  (let* ((file (make-temp-file "ink unicode " nil ".md"
                              (concat "---\ntitle: Test\n---\n# 中文🙂\n\n"
                                      "[跳转](#中文)\n\n"
                                      "```python\ndef greet(name):\n"
                                      "    message = \"中文👩‍💻\\t and a long string for wrapping\"\n"
                                      "    return message\n\n```\n\n"
                                      "```go\npackage main\n\t// 制表符\n```\n")))
         (preview (generate-new-buffer " *ink unicode preview*"))
         (hook-count 0))
    (unwind-protect
        (let ((python-mode-hook (list (lambda () (cl-incf hook-count))))
              (my-tui-ink-format 'emacs-sexp))
          (my-tui-ink-render file preview 30)
          (with-current-buffer preview
            (should (eq my-tui-ink-backend 'emacs-sexp))
            (should buffer-read-only)
            (should-not (buffer-modified-p))
            (should (= (nth 4 (aref my-tui-ink-headings 0)) 4))
            (should (= hook-count 0))
            (should-not (bound-and-true-p lsp-bridge-mode))
            (should-not (overlays-in (point-min) (point-max)))
            (goto-char (point-min))
            (search-forward "def")
            (should (eq (get-text-property (- (point) 2) 'face) 'font-lock-keyword-face))
            (search-forward "greet")
            (should (eq (get-text-property (- (point) 2) 'face) 'font-lock-function-name-face))
            (search-forward "return")
            (should (eq (get-text-property (- (point) 2) 'face) 'font-lock-keyword-face))
            (should (> (length (nth 4 (aref my-tui-ink-code-blocks 0))) 3))
            (seq-doseq (block my-tui-ink-code-blocks)
              (seq-doseq (fragment (nth 4 block))
                (should (equal (buffer-substring-no-properties (1+ (nth 0 fragment)) (1+ (nth 1 fragment)))
                               (substring (nth 3 block) (nth 2 fragment)
                                          (+ (nth 2 fragment) (- (nth 1 fragment) (nth 0 fragment))))))))
            (my-tui-ink-set-width 90)
            (should (= my-tui-ink-width 90))
            (my-tui-ink-refresh)
            (should (= my-tui-ink-width 90))))
      (kill-buffer preview)
      (delete-file file))))

(ert-deftest ink-sexp-invalid-render-keeps-existing-preview ()
  (let ((preview (generate-new-buffer " *ink preserved preview*"))
        (file (make-temp-file "ink invalid " nil ".md" "# Test\n")))
    (unwind-protect
        (progn
          (with-current-buffer preview (insert "preserve me") (read-only-mode 1))
          (cl-letf (((symbol-function 'process-file)
                     (lambda (_program _in destination &rest _)
                       (with-current-buffer (car destination) (insert "(:version 99)")) 0)))
            (should-error (my-tui-ink-render file preview 60)))
          (with-current-buffer preview (should (equal (buffer-string) "preserve me"))))
      (kill-buffer preview)
      (delete-file file))))

(ert-deftest ink-stock-ansi-fallback-and-empty-toc ()
  (let ((my-tui-ink-format 'auto) (my-tui-ink-native-program "ink-nonexistent-extension")
        (file (make-temp-file "ink fallback " nil ".md" "# Fallback\n")))
    (unwind-protect
        (with-temp-buffer
          (my-tui-ink-render file (current-buffer) 60)
          (should (eq my-tui-ink-backend 'ansi))
          (should (string-match-p "Fallback" (buffer-string)))
          (should-error (my-tui-ink-toc) :type 'user-error)
          (should buffer-read-only))
      (delete-file file))))

(ert-deftest ink-sexp-rich-showcase-and-light-render ()
  (with-temp-buffer
    (let ((my-tui-ink-format 'emacs-sexp))
      (my-tui-ink-render (expand-file-name "test-files/ink-showcase.md" user-emacs-directory)
                         (current-buffer) 60)
      (should (> (length my-tui-ink-headings) 10))
      (should (> (length my-tui-ink-code-blocks) 5))
      (should-not (string-match-p (string 27) (buffer-string)))
      (should-not (buffer-modified-p)))))

(ert-deftest ink-sidebar-default-navigation-toggle-and-cleanup ()
  (let* ((file (make-temp-file "ink sidebar " nil ".md"
                              "# First\n\nBody\n\n## Second\n\nMore\n"))
         (source (find-file-noselect file)) preview sidebar)
    (unwind-protect
        (save-window-excursion
          (switch-to-buffer source)
          (my-tui-markdown-open-in-ink)
          (setq preview (current-buffer) sidebar my-tui-ink-sidebar-buffer)
          (should (eq (window-buffer (selected-window)) preview))
          (should (buffer-live-p sidebar))
          (should (eq (window-parameter (get-buffer-window sidebar) 'window-side) 'left))
          (should mode-line-format)
          (should-not (cl-some (lambda (w) (eq (window-parameter w 'window-side) 'bottom))
                              (window-list)))
          (with-current-buffer sidebar
            (should-not (string-match-p "1\\. First" (buffer-string)))
            (goto-char (point-min))
            (forward-line 1)
            (my-tui-ink-sidebar-visit))
          (should (eq (window-buffer (selected-window)) preview))
          (with-current-buffer preview
            (should (= (point) (1+ (car (aref my-tui-ink-headings 1)))))
            (my-tui-ink-sidebar-sync))
          (with-current-buffer sidebar
            (should (= (overlay-start my-tui-ink-sidebar-highlight)
                       (save-excursion (goto-char (point-min)) (forward-line 1) (point)))))
          (my-tui-ink-toc)
          (should-not (get-buffer-window sidebar))
          (should mode-line-format)
          (my-tui-ink-refresh)
          (should-not my-tui-ink-sidebar-visible)
          (should-not (get-buffer-window sidebar))
          (my-tui-ink-toc)
          (should (get-buffer-window sidebar))
          (should my-tui-ink-sidebar-visible)
          (my-tui-ink-quit)
          (should-not (get-buffer-window sidebar))
          (should (eq (window-buffer (selected-window)) source)))
      (when (buffer-live-p preview) (kill-buffer preview))
      (should-not (buffer-live-p sidebar))
      (kill-buffer source)
      (delete-file file))))

(ert-deftest ink-sidebar-quit-preserves-unrelated-window ()
  (let* ((file (make-temp-file "ink sidebar layout " nil ".md" "# Chapter\n"))
         (source (find-file-noselect file))
         (other (generate-new-buffer " *ink unrelated*")) preview)
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (switch-to-buffer source)
          (let ((other-window (split-window-below)))
            (set-window-buffer other-window other)
            (my-tui-markdown-open-in-ink)
            (setq preview (current-buffer))
            (should (= (length (window-list)) 3))
            (my-tui-ink-quit)
            (should (= (length (window-list)) 2))
            (should (window-live-p other-window))
            (should (eq (window-buffer other-window) other))))
      (when (buffer-live-p preview) (kill-buffer preview))
      (kill-buffer source)
      (kill-buffer other)
      (delete-file file))))

(ert-deftest ink-json-code-lines-fit-one-terminal-row ()
  (let* ((file (make-temp-file "ink json rows " nil ".md"
                              "# JSON\n\n```json\n{\n  \"name\": \"demo\",\n  \"enabled\": true\n}\n```\n"))
         (source (find-file-noselect file)) preview)
    (unwind-protect
        (save-window-excursion
          (switch-to-buffer source)
          (my-tui-markdown-open-in-ink)
          (setq preview (current-buffer))
          (should truncate-lines)
          (let ((block (aref my-tui-ink-code-blocks 0))
                (window (selected-window)))
            (goto-char (1+ (car block)))
            (while (< (point) (1+ (nth 1 block)))
              (let ((beg (line-beginning-position)) (end (line-end-position)))
                (should (< (string-width (buffer-substring-no-properties beg end))
                           (window-body-width window)))
                (should (= (count-screen-lines beg end nil window) 1)))
              (forward-line 1))))
      (when (buffer-live-p preview) (kill-buffer preview))
      (kill-buffer source)
      (delete-file file))))

(ert-deftest ink-reopening-fixed-width-fits-document-and-sidebar ()
  (let* ((file (make-temp-file "ink stored width " nil ".md"
                              "# A very long heading 中文标题需要缩短以便目录显示完整\n\n```json\n{\"x\": true}\n```\n"))
         (source (find-file-noselect file)) preview)
    (unwind-protect
        (save-window-excursion
          (switch-to-buffer source)
          (my-tui-markdown-open-in-ink)
          (setq preview (current-buffer))
          (my-tui-ink-set-width 150)
          (my-tui-ink-quit)
          (my-tui-markdown-open-in-ink)
          (should (= my-tui-ink-width 150))
          (let ((width (window-body-width)))
            (goto-char (point-min))
            (while (not (eobp))
              (should (< (string-width (buffer-substring-no-properties
                                        (line-beginning-position) (line-end-position))) width))
              (forward-line 1)))
          (should (equal (display-table-slot buffer-display-table 'truncation) [8230]))
          (with-current-buffer my-tui-ink-sidebar-buffer
            (should (< (string-width (buffer-substring-no-properties (point-min) (1- (point-max))))
                       (window-body-width (get-buffer-window (current-buffer)))))
            (should (string-match-p "…" (buffer-string)))))
      (when (buffer-live-p preview) (kill-buffer preview))
      (kill-buffer source)
      (delete-file file))))

(ert-deftest ink-sidebar-follows-active-buffer ()
  (let* ((file (make-temp-file "ink lifecycle " nil ".md" "# Chapter\n\nText\n"))
         (source (find-file-noselect file))
         (other (generate-new-buffer " *ordinary reading*")) preview sidebar)
    (unwind-protect
        (save-window-excursion
          (switch-to-buffer source)
          (my-tui-markdown-open-in-ink)
          (setq preview (current-buffer) sidebar my-tui-ink-sidebar-buffer)
          (switch-to-buffer other)
          (my-tui-ink-sync-visible-windows)
          (should-not (get-buffer-window sidebar))
          (should (eq (window-buffer (selected-window)) other))
          (switch-to-buffer preview)
          (my-tui-ink-sync-visible-windows)
          (should (get-buffer-window sidebar))
          (my-tui-ink-toc)
          (switch-to-buffer other)
          (my-tui-ink-sync-visible-windows)
          (switch-to-buffer preview)
          (my-tui-ink-sync-visible-windows)
          (should-not (get-buffer-window sidebar)))
      (when (buffer-live-p preview) (kill-buffer preview))
      (kill-buffer source)
      (kill-buffer other)
      (delete-file file))))

(ert-run-tests-batch-and-exit)
