;;; tui-lsp-bridge-smoke.el --- LSP Bridge integration checks -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(setq user-emacs-directory
      (file-name-as-directory
       (expand-file-name ".." (file-name-directory load-file-name))))
(load (expand-file-name "early-init.el" user-emacs-directory) nil t)
(cl-letf (((symbol-function 'package-refresh-contents)
           (lambda (&rest _) (error "Unexpected archive refresh")))
          ((symbol-function 'package-install)
           (lambda (&rest _) (error "Unexpected package install"))))
  (load (expand-file-name "init.el" user-emacs-directory) nil t))

(ert-deftest bridge-startup-loads-acm ()
  (should (featurep 'lsp-bridge))
  (should-not (featurep 'eglot))
  (should-not (featurep 'corfu))
  (should (featurep 'acm))
  (should-not acm-enable-icon)
  (should-not lsp-bridge-enable-inlay-hint)
  (should lsp-bridge-enable-hover-diagnostic)
  (should (eq lsp-bridge-get-project-path-by-filepath #'my-tui-bridge-project-path))
  (should (equal custom-enabled-themes '(mood-one))))

(ert-deftest bridge-python-owns-completion ()
  (let ((file (make-temp-file "bridge-mode-" nil ".py" "def f():\n    return 1\n")))
    (unwind-protect
        (with-temp-buffer
          (setq buffer-file-name file)
          (insert-file-contents file)
          (python-mode)
          (should lsp-bridge-mode)
          (should-not (bound-and-true-p lsp-bridge-semantic-tokens-mode))
          (should (eq (key-binding (kbd "M-.")) #'my-tui-lsp-definition))
          (should (eq (key-binding (kbd "C-c C-d")) #'my-tui-lsp-documentation))
          (when (treesit-ready-p 'python t)
            (should indent-bars--ts-mode)))
      (delete-file file))))

(ert-deftest bridge-project-settings-preserve-source-roots-and-routing ()
  (let* ((root (make-temp-file "bridge-project-" t))
         (second-root (make-temp-file "bridge-other-project-" t))
         (python (expand-file-name ".venv/bin/python" root)))
    (unwind-protect
        (progn
          (make-directory (file-name-directory python) t)
          (write-region "" nil python nil 'silent)
          (set-file-modes python #o700)
          (make-directory (expand-file-name "library" root))
          (write-region "" nil (expand-file-name "library/setup.py" root) nil 'silent)
          (let* ((file (my-tui-bridge-single-server root (expand-file-name "main.py" root)))
                 (second-file (my-tui-bridge-single-server second-root
                                                         (expand-file-name "main.py" second-root)))
                 (settings (json-parse-string
                            (with-temp-buffer (insert-file-contents file) (buffer-string))
                            :object-type 'plist :false-object :json-false))
                 (ty (plist-get (plist-get settings :settings) :ty))
                 (env (plist-get (plist-get ty :configuration) :environment))
                 (routing (my-tui-bridge-multi-server root (expand-file-name "main.py" root))))
            (should-not (equal file second-file))
            (should (equal (plist-get env :python) python))
            (should (equal (plist-get env :extra-paths)
                           (vector root (expand-file-name "library" root))))
            (should (eq (plist-get (plist-get ty :inlayHints) :callArgumentNames) :json-false))
            (should (equal (aref (plist-get settings :command) 1) "server"))
            (should routing)
            (let* ((config (expand-file-name (concat routing ".json") lsp-bridge-user-multiserver-dir))
                   (routes (json-parse-string
                            (with-temp-buffer (insert-file-contents config) (buffer-string))
                            :object-type 'plist)))
              (should (equal (plist-get routes :default) (plist-get settings :name)))
              (should (equal (plist-get routes :diagnostics)
                             (vector (plist-get settings :name) "ruff")))
              (should (equal (plist-get routes :formatting) "ruff")))))
      (delete-directory root t)
      (delete-directory second-root t))))

(ert-deftest bridge-rust-uses-workspace-root-and-real-server-binary ()
  (let* ((root (make-temp-file "bridge-rust-workspace-" t))
         (crate (expand-file-name "core" root))
         (source (expand-file-name "src/lib.rs" crate)))
    (unwind-protect
        (progn
          (make-directory (file-name-directory source) t)
          (write-region "" nil (expand-file-name "Cargo.lock" root) nil 'silent)
          (write-region "[workspace]\n" nil (expand-file-name "Cargo.toml" root) nil 'silent)
          (write-region "[package]\nname = \"core\"\nversion = \"0.1.0\"\n"
                        nil (expand-file-name "Cargo.toml" crate) nil 'silent)
          (write-region "pub fn value() -> i32 { 1 }\n" nil source nil 'silent)
          (cl-letf (((symbol-function 'my-tui-rust-analyzer-executable)
                     (lambda () "/toolchains/stable/bin/rust-analyzer")))
            (should (equal (my-tui-bridge-project-path source) root))
            (let* ((file (my-tui-bridge-single-server root source))
                   (config (json-parse-string
                            (with-temp-buffer (insert-file-contents file) (buffer-string))
                            :object-type 'plist :false-object :json-false)))
              (should (equal (plist-get config :name) "rust-analyzer-tui"))
              (should (equal (plist-get config :command)
                             (vector "/toolchains/stable/bin/rust-analyzer")))
              (should (equal (plist-get config :projectFiles) (vector "Cargo.toml"))))))
      (delete-directory root t))))

(ert-deftest bridge-commands-use-xref-in-ordinary-buffers ()
  (let (called)
    (cl-letf (((symbol-function 'lsp-bridge-find-def)
               (lambda () (interactive) (setq called 'bridge)))
              ((symbol-function 'xref-find-definitions)
               (lambda () (interactive) (setq called 'xref))))
      (with-temp-buffer
        (setq-local lsp-bridge-mode t)
        (my-tui-lsp-definition)
        (should (eq called 'bridge))
        (setq-local lsp-bridge-mode nil)
        (my-tui-lsp-definition)
        (should (eq called 'xref))))))

(ert-deftest bridge-signature-does-not-grow-minibuffer ()
  (let (text)
    (cl-letf (((symbol-function 'message)
               (lambda (format &rest args) (setq text (apply #'format format args)))))
      (my-tui-bridge-show-signature (concat (make-string 180 ?x) "\ncontinued")))
    (should-not (string-match-p "\n" text))
    (should (< (string-width text) (window-width (minibuffer-window))))))

(ert-deftest bridge-diagnostics-use-bounded-terminal-frames ()
  (with-temp-buffer
    (insert "bad")
    (let ((overlay (make-overlay 1 4))
          (noninteractive nil)
          size)
      (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) nil))
                ((symbol-function 'window-body-width) (lambda (&rest _) 80))
                ((symbol-function 'window-body-height) (lambda (&rest _) 24))
                ((symbol-function 'acm-frame-set-frame-max-size)
                 (lambda (_frame width height) (setq size (list width height)))))
        (my-tui-bridge-diagnostic-tooltip
         (lambda (_overlay &optional _goto)
           (should (acm-frame-can-display-p))
           (should (= fill-column 72))
           (acm-frame-set-frame-max-size 'test-frame 200 50))
         overlay)
        (should (equal size '(76 10)))
        (delete-overlay overlay)
        (my-tui-bridge-diagnostic-tooltip
         (lambda (&rest _) (error "Deleted diagnostic was displayed")) overlay)))))

(ert-deftest bridge-terminal-popup-position-stays-inside-parent ()
  (let (result)
    (dolist (case '(((22 . -9) (22 . 0)) ((180 . 50) (120 . 41))))
      (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) nil))
                ((symbol-function 'frame-parent) (lambda (_) 'parent))
                ((symbol-function 'frame-width) (lambda (frame) (if (eq frame 'parent) 189 69)))
                ((symbol-function 'frame-height) (lambda (frame) (if (eq frame 'parent) 43 2)))
                ((symbol-function 'frame-position) (lambda (_) (car case)))
                ((symbol-function 'set-frame-position)
                 (lambda (_frame x y) (setq result (cons x y)))))
        (my-tui-bridge-frame-adjust
         (lambda (_frame _position margin _action) (should (= margin 1))) 'popup)
        (should (equal result (cadr case)))))))

(ert-run-tests-batch-and-exit)
;;; tui-lsp-bridge-smoke.el ends here
