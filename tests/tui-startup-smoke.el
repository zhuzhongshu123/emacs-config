;;; tui-startup-smoke.el --- Check startup without network or GUI -*- lexical-binding: t; -*-

;; Run from the repository root:
;; emacs -Q --batch -l tests/tui-startup-smoke.el
;; EMACS_TUI_SMOKE_MINIMAL=1 emacs -Q --batch -l tests/tui-startup-smoke.el
(require 'cl-lib)
(require 'ert)
(setq user-emacs-directory
      (file-name-as-directory
       (expand-file-name ".." (file-name-directory load-file-name))))
;; A legacy profile override must not resurrect the deleted GUI path.
(setenv "EMACS_PROFILE" "gui")
(load (expand-file-name "early-init.el" user-emacs-directory) nil t)
(when (getenv "EMACS_TUI_SMOKE_MINIMAL")
  (setq package-user-dir (make-temp-file "emacs-tui-empty-packages-" t)))
(cl-letf (((symbol-function 'package-refresh-contents)
           (lambda (&rest _) (error "Startup attempted an archive refresh")))
          ((symbol-function 'package-install)
           (lambda (&rest _) (error "Startup attempted a package download"))))
  (load (expand-file-name "init.el" user-emacs-directory) nil t))

(ert-deftest tui-startup-without-gui ()
  (should-not (featurep 'profile-config))
  (should-not (locate-library "gui-config"))
  (should-not (featurep 'eglot))
  (should-not (featurep 'corfu))
  (should-not (getenv "NO_COLOR"))
  (should (equal custom-enabled-themes '(mood-one)))
  (should (eq xterm-update-cursor 'color))
  (should (= (length my-tui-packages) 35))
  (should (= (length (delete-dups (copy-sequence my-tui-packages))) 35))
  (should (memq 'which-key my-tui-packages))
  (should-not (memq 'shrface my-tui-packages))
  (should-not (memq 'org-modern my-tui-packages))
  (should-not (memq 'doom-themes my-tui-packages))
  (should-not (memq 'dired-narrow my-tui-packages))
  (should-not (locate-library "remote-dev-config"))
  (should-not (locate-library "cnfonts")))

(ert-deftest tui-standard-mark-and-org-folding ()
  (should (eq (key-binding (kbd "C-c SPC")) 'set-mark-command))
  (with-temp-buffer
    (org-mode)
    (should (eq (key-binding (kbd "TAB")) 'org-cycle))
    (should-not (bound-and-true-p lsp-bridge-mode))))

(ert-deftest tui-package-free-editing ()
  (when (getenv "EMACS_TUI_SMOKE_MINIMAL")
    (should-not (featurep 'helm))
    (should (eq (key-binding (kbd "C-x C-f")) 'find-file))
    (should (eq (key-binding (kbd "C-s")) 'occur))
    (should (keymapp (lookup-key global-map (kbd "C-c C-p"))))))

(ert-deftest tui-python-server-alternatives ()
  (let ((root (make-temp-file "tui-python-server-" t)))
    (unwind-protect
        (progn
          (dolist (available '("ty" "pyrefly"))
            (cl-letf (((symbol-function 'my-tui-python-server-executable)
                       (lambda (program &rest _)
                         (when (equal program available) (concat "/test/bin/" program)))))
              (let* ((file (my-tui-bridge-single-server root (expand-file-name "main.py" root)))
                     (settings (json-parse-string
                                (with-temp-buffer (insert-file-contents file) (buffer-string))
                                :object-type 'plist)))
                (should (equal (plist-get settings :command)
                               (vector (concat "/test/bin/" available)
                                       (if (equal available "ty") "server" "lsp")))))))
          (cl-letf (((symbol-function 'my-tui-python-server-executable)
                     (lambda (program &rest _)
                       (when (equal program "pyright-langserver") "/test/bin/pyright-langserver"))))
            (should-not (my-tui-bridge-single-server root (expand-file-name "main.py" root)))))
      (delete-directory root t))))

(ert-deftest tui-python-monorepo-source-roots ()
  (let ((root (make-temp-file "emacs-python-project-" t)))
    (make-directory (expand-file-name "graphrag" root))
    (write-region "" nil (expand-file-name "graphrag/setup.py" root) nil 'silent)
    (make-directory (expand-file-name "unrelated" root))
    (should (equal (my-tui-python-source-roots root)
                   (list root (expand-file-name "graphrag" root))))))

(ert-deftest tui-helm-file-selection-keeps-code-completion-separate ()
  (when (featurep 'helm)
    (should-not helm-mode-handle-completion-in-region)
    (should (eq (key-binding (kbd "C-x C-f")) #'helm-find-files)))
  (should-not (featurep 'corfu))
  (should-not (featurep 'eglot)))

(ert-deftest tui-markdown-reader-uses-ink ()
  (when (featurep 'markdown-mode)
    (should (executable-find my-tui-ink-program))
    (should (equal my-tui-ink-theme "terminal"))
    (should (eq (lookup-key markdown-mode-map (kbd "C-c i"))
                #'my-tui-markdown-open-in-ink))
    (should-not (featurep 'shrface))
    (should-not (featurep 'org-modern))))

(ert-deftest tui-enhancements-are-enabled ()
  (should which-key-mode)
  (when (featurep 'helpful)
    (should (eq (key-binding (kbd "C-h f")) #'helpful-callable)))
  (when (featurep 'diff-hl)
    (should global-diff-hl-mode)
    (should diff-hl-margin-mode))
  (when (featurep 'vundo)
    (should (eq (key-binding (kbd "C-x u")) #'vundo)))
  (when (featurep 'dashboard)
    (should (eq dashboard-startup-banner 'ascii))
    (should-not dashboard-set-heading-icons)
    (should-not dashboard-set-file-icons)))

(ert-deftest tui-cape-preserves-existing-completion ()
  (when (featurep 'cape)
    (with-temp-buffer
      (setq-local completion-at-point-functions '(ignore))
      (my-tui-extra-completion-sources)
      (my-tui-extra-completion-sources)
      (should (memq 'ignore completion-at-point-functions))
      (should (= (cl-count 'cape-file completion-at-point-functions) 1))
      (should (= (cl-count 'cape-dabbrev completion-at-point-functions) 1)))))

(ert-deftest tui-treesit-indentation-is-active-when-grammar-exists ()
  (when (and (featurep 'indent-bars) (treesit-ready-p 'python t))
    (with-temp-buffer
      (insert "def outer():\n    if True:\n        return 1\n")
      (python-ts-mode)
      (font-lock-ensure)
      (should indent-bars-mode)
      (should indent-bars--ts-mode)
      (should indent-bars--no-stipple)
      (should (treesit-parser-list)))))

(ert-deftest tui-six-traditional-modes-retain-treesit-indentation ()
  (when (featurep 'indent-bars)
    (dolist (entry '((python python-mode "def f():\n    if True:\n        return 1\n")
                     (cpp c++-mode "namespace demo {\nclass C {\npublic:\n    int f() { return 1; }\n};\n}\n")
                     (go go-mode "package demo\nfunc f() int {\n    return 1\n}\n")
                     (rust rust-mode "fn f() -> i32 {\n    return 1;\n}\n")
                     (yaml yaml-mode "outer:\n  child:\n    key: value\n")
                     (json js-json-mode "{\n  \"outer\": {\n    \"key\": 1\n  }\n}\n")))
      (when (and (fboundp (cadr entry)) (treesit-ready-p (car entry) t))
        (with-temp-buffer
          (insert (caddr entry))
          (funcall (cadr entry))
          (font-lock-ensure)
          (should-not (eq font-lock-fontify-region-function
                          #'treesit-font-lock-fontify-region))
          (should indent-bars-mode)
          (should indent-bars--ts-mode)
          (should (eq (treesit-parser-language indent-bars-ts--parser) (car entry))))))))

(ert-deftest tui-eldoc-long-diagnostics-stay-on-one-line ()
  (let* ((diagnostic (concat (make-string 180 ?x) "\nDetails preserved here"))
         (docs (list (list diagnostic :thing 'ty)))
         (echo nil)
         (eldoc-echo-area-prefer-doc-buffer nil))
    (should-not eldoc-echo-area-use-multiline-p)
    (cl-letf (((symbol-function 'eldoc--message)
               (lambda (message) (setq echo message))))
      (eldoc-display-in-echo-area docs t))
    (should (stringp echo))
    (should-not (string-match-p "\n" echo))
    (should (<= (string-width echo) (1- (window-width (minibuffer-window)))))
    (eldoc-display-in-buffer docs nil)
    (with-current-buffer (eldoc-doc-buffer)
      (should (string-match-p "Details preserved here" (buffer-string))))))

(ert-deftest tui-programming-shortcuts-override-major-mode-defaults ()
  (dolist (mode '(python-mode c++-mode))
    (with-temp-buffer
      (funcall mode)
      (dolist (key '("C-c C-p" "C-c C-l" "C-c C-d" "C-c C-j" "C-c C-o"))
        (let ((configured (lookup-key global-map (kbd key))))
          (when configured
            (if (keymapp configured)
                (should (equal (key-binding (vconcat (kbd key) (kbd "f")))
                               (lookup-key configured (kbd "f"))))
              (should (equal (key-binding (kbd key)) configured)))))))))

(ert-deftest tui-original-control-return-and-meta-bracket ()
  (dolist (mode (append '(fundamental-mode python-mode c++-mode org-mode)
                       (when (fboundp 'markdown-mode) '(markdown-mode))))
    (with-temp-buffer
      (funcall mode)
      (insert "sample\n")
      (goto-char 3)
      (should (eq (key-binding (kbd "C-<return>")) #'set-mark-command))
      (should (eq (key-binding (kbd "M-[")) #'my-tui-meta-bracket))
      (should (eq (key-binding (kbd "ESC [")) #'my-tui-meta-bracket))
      (let ((current-prefix-arg nil))
        (call-interactively (key-binding (kbd "C-<return>"))))
      (should (= (mark) (point)))
      (should (equal (buffer-string) "sample\n")))))

(ert-deftest tui-meta-bracket-preserves-decoded-terminal-keys ()
  (dolist (event '(down right C-return))
    (let ((unread-command-events nil))
      (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) nil))
                ((symbol-function 'read-key)
                 (lambda (&rest _)
                   (should (equal unread-command-events '(27 91)))
                   (setq unread-command-events nil)
                   event))
                ((symbol-function 'my-tui-buffer-list)
                 (lambda () (error "CSI key opened buffer selector"))))
        (my-tui-meta-bracket)
        (should (equal unread-command-events (list event)))))))

(ert-deftest tui-meta-bracket-keeps-following-input ()
  (let ((unread-command-events nil) (opened nil))
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) nil))
              ((symbol-function 'read-key)
               (lambda (&rest _)
                 (setq unread-command-events '(91 7))
                 27))
              ((symbol-function 'my-tui-buffer-list) (lambda () (setq opened t))))
      (my-tui-meta-bracket)
      (should opened)
      (should (equal unread-command-events '(7))))))

(ert-deftest tui-files-open-read-only-until-explicitly-unlocked ()
  (let* ((file (make-temp-file "tui-reader-" nil ".txt" "original\n"))
         (permissions (file-modes file))
         buffer)
    (unwind-protect
        (with-current-buffer (setq buffer (find-file-noselect file))
          (should buffer-read-only)
          (should-not (my-tui-reader-completion-allowed-p))
          (should-error (insert "accidental") :type 'buffer-read-only)
          (should-not (buffer-modified-p))
          (call-interactively (key-binding (kbd "C-x C-q")))
          (should-not buffer-read-only)
          (should (my-tui-reader-completion-allowed-p))
          (insert "intentional")
          (should (buffer-modified-p))
          (should (= permissions (file-modes file)))
          (read-only-mode 1)
          (should-error (my-tui-reader-require-editing
                         (lambda () (error "Editing command should not run")))
                        :type 'user-error))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (set-buffer-modified-p nil))
        (kill-buffer buffer))
      (delete-file file))))

(ert-deftest tui-complete-hydra-menus-have-available-commands ()
  (when (featurep 'hydra)
    (dolist (entry '(("C-c C-l" . hydra-lsp-bridge/body)
                     ("C-c C-p" . hydra-projectile/body)
                     ("C-c t" . hydra-toggle/body)))
      (should (eq (lookup-key global-map (kbd (car entry))) (cdr entry))))
    (dolist (head-list (list hydra-lsp-bridge/heads hydra-projectile/heads
                            hydra-toggle/heads hydra-zoom/heads))
      (dolist (head head-list)
        (when (symbolp (cadr head))
          (when (cadr head) (should (commandp (cadr head)))))))))

(ert-deftest tui-window-maximize-restores-layout ()
  (save-window-excursion
    (delete-other-windows)
    (split-window-below)
    (set-frame-parameter nil 'my-hydra-window-configuration nil)
    (my-hydra-toggle-window-zoom)
    (should (= (length (window-list)) 1))
    (my-hydra-toggle-window-zoom)
    (should (= (length (window-list)) 2))
    (should-not (frame-parameter nil 'my-hydra-window-configuration))))

(ert-run-tests-batch-and-exit)
